# Rusuh Booking — client env template. Copy to .env (gitignored). No secrets in EXPO_PUBLIC_*.

# Backend base URL
EXPO_PUBLIC_API_BASE_URL=https://example.invalid/api

# Bind mock adapters (payment + FE-NEED gaps) vs the real BE. "true" in dev.
EXPO_PUBLIC_USE_MOCKS=true

# development | production
EXPO_PUBLIC_ENV=development
