# Rusuh Booking — client env template. Copy to .env (gitignored). No secrets in EXPO_PUBLIC_*.

# Backend base URL
EXPO_PUBLIC_API_BASE_URL=https://dev.rusuhbooking.my.id/api/v1

# Bind mock adapters (payment + FE-NEED gaps) vs the real BE. Use real BE in dev.
EXPO_PUBLIC_USE_MOCKS=false

# Optional local Maestro mock queue: default | admitted | sold-out | turn-missed.
# Rebuild/reload the mock bundle when changing this; ignored in real mode.
EXPO_PUBLIC_MAESTRO_QUEUE_SCENARIO=default

# development | production
EXPO_PUBLIC_ENV=development

# EAS Update project configuration used when generating native release builds.
# Set both values together after creating/linking the Expo project.
EXPO_PROJECT_ID=
EAS_CHANNEL=development
