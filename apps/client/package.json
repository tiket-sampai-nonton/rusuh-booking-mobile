{
  "name": "rusuh-booking-client",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "gen:api": "sh ./scripts/gen-api.sh",
    "format:check": "prettier --check --ignore-path ../../.gitignore \"src/**/*.{ts,tsx}\" \"scripts/**/*.cjs\" app.config.js \"../../.github/workflows/*.yml\"",
    "web:metadata": "node scripts/generate-web-metadata.cjs",
    "web:verify": "node scripts/verify-web.cjs",
    "postinstall": "node scripts/patch-transitive-security.cjs",
    "prepare": "cd ../.. && git config core.hooksPath .husky"
  },
  "overrides": {
    "image-size": "2.0.3",
    "postcss": "8.5.23"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "sh -c 'ESLINT_USE_FLAT_CONFIG=false eslint \"$@\"' --"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@tanstack/react-query": "5.105.0",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.1.23",
    "qrcode": "^1.5.4",
    "query-string": "^9.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-qrcode-svg": "^6.3.49",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.6.2",
    "react-test-renderer": "19.0.0",
    "typescript": "5.8.3"
  }
}
